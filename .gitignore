# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terraform dependency lock file
# Uncomment the next line if you do NOT want to commit it.
.terraform.lock.hcl

# Variable files containing secrets
# *.tfvars
*.tfvars.json

# Plan files
*.tfplan
*.plan

# Sensitive environment files
# .env
# .env.*